Output docs/demos/gifs/policies-doc.gif
Set Shell "bash"
Set FontSize 14
Set Width 1280
Set Height 720
Set TypingSpeed 40ms
Set PlaybackSpeed 0.5
Set Theme "Catppuccin Mocha"

Type "cd docs/demos/fixtures && gitlab-compliance policies doc -f policies/ -o /tmp/policy-catalog.md && head -n 40 /tmp/policy-catalog.md"
Enter
Sleep 5s
